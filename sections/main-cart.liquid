<div class="cart-page max-w-1280 section" style="padding-top: {{ section.settings.padding_top }}px;">
  <h1 class="h2" style="margin-bottom: 2rem;">{{ section.settings.heading | default: "Cart" }}</h1>
  {% if cart.empty? %}
    <p>Your cart is empty.</p>
    <a href="{{ routes.all_products_collection_url }}" class="button button--primary" style="margin-top: 1rem;">Continue Shopping</a>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post" id="cart" class="cart-form">
      <ul class="cart-items" style="list-style: none; padding: 0;">
      {% for item in cart.items %}
        <li style="display: flex; gap: 20px; align-items: center; border-bottom: 1px solid #ddd; padding: 15px 0;">
          <img src="{{ item.image | image_url: width: 100 }}" style="width: 100px; height: auto;" />
          <div style="flex: 1;">
            <a href="{{ item.url }}" style="font-weight: 500;">{{ item.title }}</a>
            <div style="color: #666; margin-top: 5px;">{{ item.price | money }} x {{ item.quantity }}</div>
          </div>
        </li>
      {% endfor %}
      </ul>
      <div style="margin-top: 30px; text-align: right;">
        <button type="submit" name="checkout" class="button button--primary">Checkout</button>
      </div>
    </form>
  {% endif %}
</div>

{% schema %}
{
  "name": "Cart Section",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Cart"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    }
  ]
}
{% endschema %}
