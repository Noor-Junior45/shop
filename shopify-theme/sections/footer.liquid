<footer class="footer">
  <div class="max-w-1280">
    <div class="footer__grid">
      <div class="footer__brand">
        <h2 class="footer__logo h2">{{ shop.name }}</h2>
        <p class="footer__text">Elevating men's fashion with timeless designs, ethical sourcing, and uncompromising quality.</p>
      </div>
      
      {%- for block in section.blocks -%}
        <div class="footer__block">
          <h4 class="footer__block-title">{{ block.settings.title | escape }}</h4>
          {%- if block.settings.menu != blank -%}
            <ul class="footer__list">
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    
    <div class="footer__bottom">
      <p class="footer__copyright">&copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. All rights reserved.</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "link_list"
      }
    ]
  }
}
{% endschema %}
