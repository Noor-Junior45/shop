<div class="cart-page">
  <h1>Cart</h1>
  {% if cart.empty? %}
    <p>Your cart is empty.</p>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post" id="cart">
      {% for item in cart.items %}
        <div>{{ item.title }}</div>
      {% endfor %}
      <button type="submit" name="checkout">Checkout</button>
    </form>
  {% endif %}
</div>

{% schema %}
{
  "name": "Cart Section",
  "tag": "section",
  "settings": []
}
{% endschema %}
