<div class="image-with-text split-hero">
  <div class="image-with-text__text-item bg-light-gray">
    <div class="image-with-text__content">
      {%- if section.settings.subtitle != blank -%}
        <p class="image-with-text__subtitle caption-with-letter-spacing">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="image-with-text__heading h1">
          {{ section.settings.title | escape }}
        </h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="image-with-text__text body">
          {{ section.settings.text }}
        </div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a{% if section.settings.button_link == blank %} role="link" aria-disabled="true"{% else %} href="{{ section.settings.button_link }}"{% endif %} class="button button--primary">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
  <div class="image-with-text__media-item">
    <div class="image-with-text__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1500 | image_tag:
          loading: 'lazy',
          class: 'split-hero__image'
        }}
      {%- else -%}
        <!-- Placeholder -->
        <img src="https://images.unsplash.com/photo-1483985988355-763728e1935b?ixlib=rb-4.0.3&auto=format&fit=crop&w=1600&q=80" alt="Placeholder" class="split-hero__image">
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Split Hero",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Recommended For You"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Essential Merino Collection"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Tailored for your specific profile. A timeless silhouette crafted from ethically sourced ultra-fine wool.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop The Look"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Split Hero"
    }
  ]
}
{% endschema %}
